# ============================================================
# FINBOT — Variables de entorno
# Copia este archivo como .env y rellena tus claves
# NUNCA subas .env a git (ya está en .gitignore)
# ============================================================

# Clave de OpenAI — https://platform.openai.com
# Usada como fallback si no hay webhook de n8n configurado
VITE_OPENAI_KEY=sk-proj-XXXXXXXXXX

# Webhook de n8n (opcional — actívalo para enrutar por n8n)
# Si se define, el bot llamará a este endpoint en vez de OpenAI directamente
VITE_N8N_WEBHOOK=https://tu-n8n.app.n8n.cloud/webhook/finbot
