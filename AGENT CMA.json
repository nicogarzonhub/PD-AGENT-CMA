    {
      "parameters": {
        "jsCode": "let copRate = 4100;\nconst data = $input.first().json;\nif (data && data.rates && data.rates.COP) {\n  copRate = data.rates.COP;\n}\n\nconst userMessage = $('Extract Variables').first().json.userMessage;\n\nconst numbers = userMessage.match(/\\d+(\\.\\d+)?/g);\nlet amount = 1;\nlet isConversion = false;\n\nif (numbers && numbers.length >= 1) {\n  amount = parseFloat(numbers[0]);\n  isConversion = true;\n}\n\nlet text = `La tasa actual USD/COP es ${copRate.toLocaleString('es-CO')} pesos por dólar.`;\n\nif (isConversion && amount !== 1) {\n  const converted = amount * copRate;\n  text = `${amount} USD equivalen aproximadamente a ${converted.toLocaleString('es-CO', { minimumFractionDigits: 2 })} COP (a una tasa de ${copRate}).`;\n}\n\n// Add a warning if fallback was used\nif (!data || !data.rates) {\n  text = \"⚠️ Usando tasa de cambio aproximada (API no disponible):\\n\" + text;\n}\n\nreturn [{\n  text: text,\n  toolUsed: 'exchange_rate'\n}];"
      },
      "id": "6e5a9b02-79c2-4816-88df-3a9a02c2f5f9",
