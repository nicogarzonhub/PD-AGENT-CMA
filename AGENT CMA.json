      "id": "3c813271-8ba0-4f37-a94e-baaf1db4935a",
      "name": "Fetch Crypto Prices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1264,
        544
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nlet text = '';\n\nif (data && data.bitcoin && data.ethereum) {\n  text = `Precios actuales de criptomonedas:\\nBitcoin (BTC): $${data.bitcoin.usd.toLocaleString('en-US')} USD / $${data.bitcoin.cop.toLocaleString('es-CO')} COP\\nEthereum (ETH): $${data.ethereum.usd.toLocaleString('en-US')} USD / $${data.ethereum.cop.toLocaleString('es-CO')} COP`;\n} else {\n  // Fallback si la API de CoinGecko falla (muy común desde servidores cloud)\n  const btcUsd = 67800;\n  const ethUsd = 3540;\n  const rate = 4100;\n  text = `⚠️ Usando precios aproximados (API no disponible):\\nBitcoin (BTC): $${btcUsd.toLocaleString('en-US')} USD / $${(btcUsd * rate).toLocaleString('es-CO')} COP\\nEthereum (ETH): $${ethUsd.toLocaleString('en-US')} USD / $${(ethUsd * rate).toLocaleString('es-CO')} COP`;\n}\n\nreturn [{\n  text: text,\n  toolUsed: 'crypto'\n}];"
      },
      "id": "c9209d9d-683d-4993-af05-60873cf4f3b9",
      "name": "Format Crypto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1488,
        592
      ]
    },
    {
      "parameters": {
        "jsCode": "const userMessage = $input.first().json.output;\n\n\n\n// Extract numbers from message using regex\nconst numbers = userMessage.match(/\\d+(\\.\\d+)?/g);\n\nlet principal = 1000000; // default 1M COP\nlet rate = 5; // default 5%\nlet years = 1; // default 1 year\n\nif (numbers && numbers.length >= 1) {\n  principal = parseFloat(numbers[0]);\n}\nif (numbers && numbers.length >= 2) {\n  rate = parseFloat(numbers[1]);\n}\nif (numbers && numbers.length >= 3) {\n  years = parseFloat(numbers[2]);\n}\n\nconst finalAmount = principal * Math.pow(1 + rate / 100, years);\nconst interest = finalAmount - principal;\n\nreturn [{\n  principal: principal,\n  rate: rate,\n  years: years,\n  finalAmount: finalAmount.toFixed(2),\n  interest: interest.toFixed(2),\n  text: `Con un capital inicial de $${principal.toLocaleString('es-CO')} COP a una tasa del ${rate}% anual durante ${years} año(s), obtendrías $${finalAmount.toLocaleString('es-CO', { minimumFractionDigits: 2 })} COP. Interés ganado: $${interest.toLocaleString('es-CO', { minimumFractionDigits: 2 })} COP.`,\n  toolUsed: 'calculate_interest'\n}];"
      },
